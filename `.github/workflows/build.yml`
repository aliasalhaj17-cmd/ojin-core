name: Clean Build Ojin Core

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Prepare Clean Web Assets
        run: |
          mkdir -p www
          cp -f index.html www/index.html
          cp -f icon.png www/icon.png 2>/dev/null || true

          cat << 'EOF' > package.json
          {
            "name": "ojin-core",
            "version": "1.0.0",
            "dependencies": {
              "@capacitor/core": "^6.0.0",
              "@capacitor/android": "^6.0.0"
            },
            "devDependencies": {
              "@capacitor/cli": "^6.0.0"
            }
          }
          EOF

          cat << 'EOF' > capacitor.config.json
          {
            "appId": "com.ojin.smartcore",
            "appName": "أوجن",
            "webDir": "www",
            "bundledWebRuntime": false
          }
          EOF

      - name: Generate Fresh Android Project
        run: |
          npm install
          npx cap add android
          npx cap sync android

      - name: Inject Icon to Android
        run: |
          if [ -f "icon.png" ]; then
            for dir in android/app/src/main/res/mipmap-*; do
              [ -d "$dir" ] && cp -f icon.png "$dir/ic_launcher.png" 2>/dev/null || true
              [ -d "$dir" ] && cp -f icon.png "$dir/ic_launcher_round.png" 2>/dev/null || true
            done
          fi

      - name: Build and Sign Final APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleRelease
          
          keytool -genkeypair -v -keystore release.keystore -alias ojin_key -keyalg RSA -keysize 2048 -validity 10000 -storepass ojinpass123 -keypass ojinpass123 -dname "CN=Ojin, OU=AI, O=Core, L=Sanaa, S=Yemen, C=YE" -noprompt
          
          BUILD_TOOLS=$(ls -d $ANDROID_HOME/build-tools/* | tail -n 1)
          $BUILD_TOOLS/zipalign -v -p 4 app/build/outputs/apk/release/app-release-unsigned.apk app/build/outputs/apk/release/ojin-aligned.apk
          $BUILD_TOOLS/apksigner sign --ks release.keystore --ks-pass pass:ojinpass123 --key-pass pass:ojinpass123 --out app/build/outputs/apk/release/ojin-core.apk app/build/outputs/apk/release/ojin-aligned.apk

      - name: Upload Pure Ojin APK
        uses: actions/upload-artifact@v4
        with:
          name: Ojin-Pure-Core
          path: android/app/build/outputs/apk/release/ojin-core.apk
          if-no-files-found: error
